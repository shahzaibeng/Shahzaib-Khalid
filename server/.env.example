# Optional locally: these defaults run the API without a database.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Email delivery for the contact form (resend.com/api-keys). Leave empty to disable.
RESEND_API_KEY=
CONTACT_TO=shahzaibkhalid.eng@gmail.com
# Reserved for the database phase. Merely setting this does not connect the database.
DATABASE_URL=
# For deployment, HOST must be 0.0.0.0 and FRONTEND_ORIGIN your real frontend origin.
